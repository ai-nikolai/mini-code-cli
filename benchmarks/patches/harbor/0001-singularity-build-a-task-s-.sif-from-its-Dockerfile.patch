+    async def _build_sif_from_dockerfile(self, *, force_build: bool = False) -> Path:
+        """Build a .sif from ``environment/Dockerfile`` (no registry, no daemon).
+
+        Apptainer builds the definition directly, so a task that only ships a
+        Dockerfile becomes runnable without Docker and without a remote image.
+        ``--fakeroot`` is required because task Dockerfiles install packages; when
+        the cluster forbids user namespaces that is reported as such rather than
+        as an opaque build failure.
+        """
+        dockerfile = self._dockerfile_path
+        if not dockerfile.is_file():
+            raise FileNotFoundError(f"No Dockerfile at {dockerfile}")
+
+        safe_name = self._derived_image_ref().replace("/", "_").replace(":", "_")
+        sif_path = self._image_cache_dir / f"{safe_name}.sif"
+        lock_path = self._image_cache_dir / f"{safe_name}.sif.lock"
+        self._image_cache_dir.mkdir(parents=True, exist_ok=True)
+
+        if not force_build and sif_path.exists():
+            self.logger.debug(f"Using cached Singularity image: {sif_path}")
+            return sif_path
+
+        lock_file = open(lock_path, "w")
+        try:
+            loop = asyncio.get_event_loop()
+            await loop.run_in_executor(
+                None, lambda: fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX)
+            )
+            if not force_build and sif_path.exists():
+                self.logger.debug(
+                    f"Using cached Singularity image (built by another process): "
+                    f"{sif_path}"
+                )
+                return sif_path
+            if force_build and sif_path.exists():
+                sif_path.unlink()
+
+            tmp_sif_path = (
+                self._image_cache_dir / f"{safe_name}.sif.tmp.{self.session_id}"
+            )
+            cmd = [
+                self._binary,
+                "build",
+                "--force",
+                "--fakeroot",
+                str(tmp_sif_path),
+                str(dockerfile.parent),
+            ]
+            self.logger.debug(
+                f"Building .sif from {dockerfile}: {' '.join(cmd)} "
+                f"(APPTAINER_CACHEDIR={os.environ.get('APPTAINER_CACHEDIR', '<unset>')}, "
+                f"APPTAINER_TMPDIR={os.environ.get('APPTAINER_TMPDIR', '<unset>')})"
+            )
+            process = await asyncio.create_subprocess_exec(
+                *cmd,
+                stdout=asyncio.subprocess.PIPE,
+                stderr=asyncio.subprocess.STDOUT,
+            )
+            stdout, _ = await process.communicate()
+            output = stdout.decode(errors="replace")
+
+            if process.returncode != 0:
+                if tmp_sif_path.exists():
+                    tmp_sif_path.unlink()
+                tail = "\n".join(output.strip().splitlines()[-20:])
+                if "fakeroot" in output.lower() or "user namespace" in output.lower():
+                    raise RuntimeError(
+                        "Failed to build a Singularity image from "
+                        f"{dockerfile}: this host cannot use --fakeroot, which task "
+                        "Dockerfiles need in order to install packages. Ask the "
+                        "cluster administrators whether unprivileged user "
+                        "namespaces are permitted, or provide a prebuilt .sif via "
+                        "task.toml [environment] docker_image.\n"
+                        f"Build output:\n{tail}"
+                    )
+                raise RuntimeError(
+                    f"Failed to build a Singularity image from {dockerfile}:\n{tail}"
+                )
+
+            tmp_sif_path.rename(sif_path)
+            self.logger.debug(f"Created Singularity image: {sif_path}")
+            return sif_path
+        finally:
+            fcntl.flock(lock_file.fileno(), fcntl.LOCK_UN)
+            lock_file.close()
+
+    async def _ensure_sif(self, *, force_build: bool = False) -> Path:
+        """Resolve the task's image to a .sif, building or pulling as needed."""
+        if self._is_sif_image:
+            sif_path = Path(self._docker_image)
+            if not sif_path.exists():
+                raise FileNotFoundError(
+                    f".sif file not found: {sif_path}. Build it first "
+                    f"(apptainer build --fakeroot {sif_path} <definition>)."
+                )
+            return sif_path
+        if self._docker_image:
+            return await self._convert_docker_to_sif(
+                self._docker_image, force_pull=force_build or self._force_pull
+            )
+        return await self._build_sif_from_dockerfile(
+            force_build=force_build or self._force_pull
+        )
+
