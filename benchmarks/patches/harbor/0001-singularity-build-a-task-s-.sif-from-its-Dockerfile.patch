+++ b/src/harbor/environments/singularity/bootstrap.sh
@@ -7,13 +7,31 @@ mkdir -p "$WORKDIR"
 
 export DEBIAN_FRONTEND=noninteractive
 
+# --- Fast path: an image may ship /opt/harbor-server already (the recommended
+# --- setup for HPC, where installing python3 inside every task is both slow and
+# --- often impossible). If that venv has uvicorn+fastapi, nothing else is needed.
+_HARBOR_VENV=/opt/harbor-server
+_HARBOR_PY="$_HARBOR_VENV/bin/python3"
+if [ -x "$_HARBOR_PY" ] && "$_HARBOR_PY" -c "import uvicorn, fastapi" 2>/dev/null; then
