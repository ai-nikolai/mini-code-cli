+  _SYS_PY="$(command -v python3)"
+fi
 if [ ! -x "$_SYS_PY" ]; then
   echo "[harbor] /usr/bin/python3 not found, installing..." >&2
   if command -v apt-get >/dev/null 2>&1; then
@@ -26,14 +44,15 @@ if [ ! -x "$_SYS_PY" ]; then
     yum install -y python3 2>/dev/null || true
   fi
   if [ ! -x "$_SYS_PY" ]; then
-    echo "[harbor] FATAL: cannot install /usr/bin/python3" >&2
+    echo "[harbor] FATAL: no python3 in the image and none could be installed." >&2
+    echo "[harbor] Bake a server venv into the image instead:" >&2
+    echo "[harbor]   RUN python3 -m venv /opt/harbor-server && \\" >&2
+    echo "[harbor]       /opt/harbor-server/bin/pip install uvicorn fastapi" >&2
