index 00000000..7a563e06
--- /dev/null
+++ b/tests/unit/environments/test_singularity_apptainer.py
@@ -0,0 +1,192 @@
+"""Unit tests for the Apptainer/Singularity image resolution added on our fork.
+
+These cover the three things a Docker-free cluster needs and that upstream
+0.24.0 did not do:
+
+1. a task that ships only ``environment/Dockerfile`` becomes runnable (the image
+   is built locally and cached under a content-addressed name),
+2. ``docker_image`` still wins when it is set, and a prebuilt ``.sif`` is used
+   as-is,
+3. the container binary and mount defaults are what the cluster expects
+   (``apptainer`` when installed, ``--no-mount home,tmp``, no ``bind-paths``
+   suppression -- that one silently dropped ``/etc/resolv.conf`` and killed DNS).
+"""
+
+import logging
+from pathlib import Path
+
+import pytest
+
+from harbor.environments.singularity import singularity as singularity_module
+from harbor.environments.singularity.singularity import SingularityEnvironment
+from harbor.models.task.config import EnvironmentConfig, NetworkMode, NetworkPolicy
+from harbor.models.trial.paths import TrialPaths
+
+DOCKERFILE = "FROM ubuntu:22.04\nRUN apt-get update && apt-get install -y tmux\n"
+
+
+def _make_env(tmp_path: Path, *, docker_image=None, dockerfile=DOCKERFILE, **kwargs):
+    env_dir = tmp_path / "environment"
+    env_dir.mkdir(parents=True, exist_ok=True)
+    if dockerfile is not None:
+        (env_dir / "Dockerfile").write_text(dockerfile)
+    trial_dir = tmp_path / "trial"
+    trial_dir.mkdir(parents=True, exist_ok=True)
+    trial_paths = TrialPaths(trial_dir=trial_dir)
+    trial_paths.mkdir()
+    return SingularityEnvironment(
+        environment_dir=env_dir,
+        environment_name="my-task",
+        session_id="Test.Session.123",
+        trial_paths=trial_paths,
+        task_env_config=EnvironmentConfig(
+            cpus=2, memory_mb=2048, docker_image=docker_image
+        ),
+        network_policy=NetworkPolicy(network_mode=NetworkMode.PUBLIC, allowed_hosts=[]),
+        logger=logging.getLogger("test"),
+        singularity_image_cache_dir=tmp_path / "cache",
+        **kwargs,
+    )
+
+
+def test_definition_with_only_a_dockerfile_is_valid(tmp_path):
+    # Construction validates, so getting here at all is the assertion.
+    env = _make_env(tmp_path)
+    assert env._has_dockerfile
+
+
+def test_definition_with_neither_dockerfile_nor_image_is_rejected(tmp_path):
+    with pytest.raises(ValueError, match="environment/Dockerfile"):
+        _make_env(tmp_path, dockerfile=None)
+
+
+def test_derived_image_ref_is_content_addressed(tmp_path):
+    first = _make_env(tmp_path / "a")._derived_image_ref()
+    same = _make_env(tmp_path / "b")._derived_image_ref()
+    changed = _make_env(
+        tmp_path / "c", dockerfile=DOCKERFILE + "RUN echo extra\n"
+    )._derived_image_ref()
+
+    assert first.startswith("harbor-local/my-task:")
+    assert first == same, "same task + same Dockerfile must give the same tag"
+    assert first != changed, "editing the Dockerfile must invalidate the cache"
+
+
+def test_binary_prefers_apptainer_and_honours_the_override(tmp_path, monkeypatch):
+    env = _make_env(tmp_path)
+    monkeypatch.delenv("HARBOR_CONTAINER_BIN", raising=False)
+    monkeypatch.setattr(
+        singularity_module.shutil,
+        "which",
+        lambda name: f"/usr/bin/{name}" if name == "apptainer" else None,
+    )
+    assert env._binary == "/usr/bin/apptainer"
+
+    monkeypatch.setenv("HARBOR_CONTAINER_BIN", "/opt/wrapped/singularity")
+    assert env._binary == "/opt/wrapped/singularity"
+
+
+@pytest.mark.asyncio
+async def test_ensure_sif_builds_from_dockerfile(tmp_path, monkeypatch):
+    env = _make_env(tmp_path)
+    calls = []
+
+    async def fake_build(*, force_build=False):
+        calls.append(force_build)
+        return tmp_path / "cache" / "built.sif"
+
+    monkeypatch.setattr(env, "_build_sif_from_dockerfile", fake_build)
+    assert await env._ensure_sif() == tmp_path / "cache" / "built.sif"
+    assert calls == [False]
+
+
+@pytest.mark.asyncio
+async def test_ensure_sif_prefers_a_prebuilt_sif(tmp_path, monkeypatch):
+    sif = tmp_path / "image.sif"
+    sif.write_text("not really a sif")
+    env = _make_env(tmp_path, docker_image=str(sif))
+    monkeypatch.setattr(
+        env,
+        "_build_sif_from_dockerfile",
+        lambda **_: pytest.fail("a prebuilt .sif must not be rebuilt"),
+    )
+    assert await env._ensure_sif() == sif
+
+
+@pytest.mark.asyncio
+async def test_ensure_sif_pulls_a_docker_image_when_given(tmp_path, monkeypatch):
+    env = _make_env(tmp_path, docker_image="ubuntu:22.04")
+    seen = []
+
+    async def fake_convert(image, *, force_pull=False):
+        seen.append((image, force_pull))
+        return tmp_path / "cache" / "ubuntu.sif"
+
+    monkeypatch.setattr(env, "_convert_docker_to_sif", fake_convert)
+    assert await env._ensure_sif(force_build=True) == tmp_path / "cache" / "ubuntu.sif"
+    assert seen == [("ubuntu:22.04", True)]
+
+
+def test_no_mount_default_keeps_dns(tmp_path):
+    """`bind-paths` suppression is what silently dropped /etc/resolv.conf."""
+    env = _make_env(tmp_path)
+    assert env._singularity_no_mount is None  # resolved to the default at start
+    source = (
+        Path(singularity_module.__file__).read_text().splitlines()
+    )
+    defaults = [line for line in source if 'singularity_no_mount = "' in line]
+    assert defaults, "the default must be spelled out in _start_server"
+    assert all("bind-paths" not in line for line in defaults)
+
+
+@pytest.mark.asyncio
+async def test_build_from_dockerfile_uses_fakeroot_and_cache_dirs(tmp_path, monkeypatch):
+    env = _make_env(tmp_path)
+    monkeypatch.setenv("APPTAINER_CACHEDIR", str(tmp_path / "cache"))
+    commands = []
+
+    class FakeProcess:
+        returncode = 0
+
+        async def communicate(self):
+            return b"INFO: Build complete\n", b""
+
+    async def fake_exec(*cmd, **kwargs):
+        commands.append(list(cmd))
+        # `apptainer build` writes the image itself; the fake has to as well, or
+        # the rename onto the cache path has nothing to move.
+        tmp_sif = [part for part in cmd if ".sif" in str(part)]
+        if tmp_sif:
+            Path(tmp_sif[0]).write_text("fake sif")
+        return FakeProcess()
+
+    monkeypatch.setattr(
+        singularity_module.asyncio, "create_subprocess_exec", fake_exec
+    )
+    sif = await env._build_sif_from_dockerfile()
+    assert sif.exists() and sif.suffix == ".sif"
+    assert commands, "the build must actually shell out"
+    argv = commands[0]
+    assert argv[1:3] == ["build", "--force"]
+    assert "--fakeroot" in argv
+    assert argv[-1] == str(env._dockerfile_path.parent)
+
+
+@pytest.mark.asyncio
+async def test_build_from_dockerfile_explains_a_fakeroot_refusal(tmp_path, monkeypatch):
+    env = _make_env(tmp_path)
+
+    class FakeProcess:
+        returncode = 1
+
+        async def communicate(self):
+            return b"FATAL: user namespaces are not enabled\n", b""
+
+    async def fake_exec(*cmd, **kwargs):
+        return FakeProcess()
+
+    monkeypatch.setattr(
+        singularity_module.asyncio, "create_subprocess_exec", fake_exec
+    )
+    with pytest.raises(RuntimeError, match="fakeroot"):
+        await env._build_sif_from_dockerfile()
