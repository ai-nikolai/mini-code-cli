From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mini-code benchmarks <benchmarks@localhost>
Date: Fri, 23 Oct 2026 18:34:36 +0100
Subject: [PATCH] singularity: WORKDIR is a cwd, and make a quiet trial
 diagnosable

Three fixes, all found by running a real Dockerfile-only task end to end:

- WORKDIR emitted only `mkdir -p`, but in Docker it is also the directory later
  RUN steps execute in: `RUN curl -o bn_sample_10k.csv` after `WORKDIR /app` puts
  the file in /app, and without the `cd` it landed in / and a correct solution
  scored 0 against a 9-test verifier. %post is one shell, so a `cd` persists.
- the image cache key is now the *translated definition*, not the Dockerfile: a
  translation fix (like the one above) must not silently reuse the .sif built by
  the old translation.
- every request is traced to /staging/harbor-requests.log (and stderr at debug),
  because "the server is up and nothing happens" was undiagnosable: access logs
  were off and the trace file is on the host, so it can be read from outside a
  trial that is still running. HARBOR_SERVER_ACCESS_LOG=1 turns on uvicorn's own
  access log too.

Verified: `harbor run -p <task with only a Dockerfile> -a oracle --env singularity`
now reports reward 1 with 9/9 verifier tests, no Docker daemon.
---
 .../environments/singularity/dockerfile.py    |  9 ++++-
 src/harbor/environments/singularity/server.py | 39 ++++++++++++++++++-
 .../environments/singularity/singularity.py   | 17 +++++---
 .../test_singularity_dockerfile.py            |  5 ++-
 4 files changed, 59 insertions(+), 11 deletions(-)

diff --git a/src/harbor/environments/singularity/dockerfile.py b/src/harbor/environments/singularity/dockerfile.py
index 8bb647d4..b76fc5c6 100644
--- a/src/harbor/environments/singularity/dockerfile.py
+++ b/src/harbor/environments/singularity/dockerfile.py
@@ -79,9 +79,14 @@ def to_definition(dockerfile: Path) -> str:
             if keyword == "RUN":
                 post.append(_strip_mounts(rest))
             elif keyword == "WORKDIR":
-                # /app may not exist in the base image, and apptainer will refuse
-                # to start a container whose working directory is missing.
+                # WORKDIR is two things in Docker: the directory later RUN steps
+                # execute in, *and* the directory the container starts in. Both
+                # matter -- a `RUN curl -o sample.csv` after `WORKDIR /app` puts the
+                # file in /app, and a bare mkdir would leave it in / and make a
+                # correct solution look wrong. /post runs as one shell, so a `cd`
+                # persists for the following lines.
                 post.append(f"mkdir -p {shlex.quote(rest)}")
+                post.append(f"cd {shlex.quote(rest)}")
             elif keyword == "ENV":
                 env.append(_env_line(rest))
             elif keyword in ("COPY", "ADD"):
diff --git a/src/harbor/environments/singularity/server.py b/src/harbor/environments/singularity/server.py
index 04f9644a..abcce854 100644
--- a/src/harbor/environments/singularity/server.py
+++ b/src/harbor/environments/singularity/server.py
@@ -14,15 +14,17 @@ import asyncio
 import inspect
 import logging
 import os
+from pathlib import Path
 import shutil
 import signal
 import subprocess
+import time
 import sys
 from contextlib import asynccontextmanager
 from typing import Dict, Optional
 
 import uvicorn
-from fastapi import FastAPI
+from fastapi import FastAPI, Request
 from pydantic import BaseModel
 
 
@@ -112,6 +114,34 @@ async def lifespan(app: FastAPI):
 
 app = FastAPI(lifespan=lifespan)
 
+#: Where request traces go. `/staging` is bind-mounted from the host, so the trace
+#: is readable from outside a trial that is still running -- which is the only way
+#: to answer "did the harness send anything at all?" when a trial goes quiet.
+REQUEST_LOG = Path(os.environ.get("HARBOR_REQUEST_LOG", "/staging/harbor-requests.log"))
+
+
+@app.middleware("http")
+async def _trace_requests(request: Request, call_next):
+    started = time.monotonic()
+    try:
+        response = await call_next(request)
+    except Exception as exc:  # noqa: BLE001 - the trace is best effort
+        _trace(f"{request.method} {request.url.path} FAILED {exc}")
+        raise
+    _trace(f"{request.method} {request.url.path} {response.status_code} "
+           f"{time.monotonic() - started:.2f}s")
+    return response
+
+
+def _trace(line: str) -> None:
+    """Append one line to the request trace; never let tracing break a request."""
+    logger.debug(f"[request] {line}")
+    try:
+        with open(REQUEST_LOG, "a", encoding="utf-8") as handle:
+            handle.write(line + "\n")
+    except OSError:
+        pass
+
 
 @app.post("/exec", response_model=CommandResult)
 def exec_command(req: CommandRequest):
@@ -419,11 +449,16 @@ def main():
             timeout_keep_alive = 120
     except (ValueError, TypeError):
         pass
+    # One line per request when asked: with access_log off a trial that stalls
+    # between "server is ready" and the first result is completely opaque (the
+    # question is always "did the harness send /exec at all?").
+    access_log = os.environ.get("HARBOR_SERVER_ACCESS_LOG", "").lower() in (
+        "1", "true", "yes")
     uvicorn.run(
         app,
         host="127.0.0.1",
         port=args.port,
-        access_log=False,
+        access_log=access_log,
         server_header=False,
         timeout_graceful_shutdown=timeout_graceful_shutdown,
         timeout_keep_alive=timeout_keep_alive,
diff --git a/src/harbor/environments/singularity/singularity.py b/src/harbor/environments/singularity/singularity.py
index 2afea6b0..a63b2da2 100644
--- a/src/harbor/environments/singularity/singularity.py
+++ b/src/harbor/environments/singularity/singularity.py
@@ -158,13 +158,16 @@ class SingularityEnvironment(BaseEnvironment):
             return override
         return shutil.which("apptainer") or shutil.which("singularity") or "singularity"
 
-    def _derived_image_ref(self) -> str:
+    def _derived_image_ref(self, payload: bytes | None = None) -> str:
         """A deterministic, content-addressed tag for a Dockerfile-only task.
 
-        The tag carries a hash of the Dockerfile so the build cache cannot go
-        stale: edit the Dockerfile and the name changes with it.
+        The tag carries a hash of what actually determines the image -- the
+        translated definition, so a change to either the Dockerfile or the
+        translation invalidates the cache (a stale .sif built by an older
+        translation is otherwise indistinguishable from a fresh one).
         """
-        digest = hashlib.sha256(self._dockerfile_path.read_bytes()).hexdigest()[:12]
+        data = payload if payload is not None else self._dockerfile_path.read_bytes()
+        digest = hashlib.sha256(data).hexdigest()[:12]
         name = re.sub(r"[^a-z0-9_.-]+", "-", (self.environment_name or "task").lower())
         return f"harbor-local/{name}:{digest}"
 
@@ -329,7 +332,9 @@ class SingularityEnvironment(BaseEnvironment):
         if not dockerfile.is_file():
             raise FileNotFoundError(f"No Dockerfile at {dockerfile}")
 
-        safe_name = self._derived_image_ref().replace("/", "_").replace(":", "_")
+        definition_text = to_definition(dockerfile)
+        safe_name = (self._derived_image_ref(definition_text.encode())
+                     .replace("/", "_").replace(":", "_"))
         sif_path = self._image_cache_dir / f"{safe_name}.sif"
         lock_path = self._image_cache_dir / f"{safe_name}.sif.lock"
         self._image_cache_dir.mkdir(parents=True, exist_ok=True)
@@ -361,7 +366,7 @@ class SingularityEnvironment(BaseEnvironment):
             # Dockerfile -- no bash, no WORKDIR. The Dockerfile has to become a
             # definition file first.
             definition = dockerfile.parent / f".harbor-{self.session_id}.def"
-            definition.write_text(to_definition(dockerfile))
+            definition.write_text(definition_text)
             cmd = [
                 self._binary,
                 "build",
diff --git a/tests/unit/environments/test_singularity_dockerfile.py b/tests/unit/environments/test_singularity_dockerfile.py
