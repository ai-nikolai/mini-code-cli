+++ b/tests/unit/environments/test_singularity_dockerfile.py
@@ -27,8 +27,11 @@ CMD ["bash"]
     assert "Bootstrap: docker" in definition
     assert "From: ubuntu:24.04" in definition
     assert "export BN_URL=https://example/x.csv" in definition
-    # apptainer refuses to start with a missing working directory
