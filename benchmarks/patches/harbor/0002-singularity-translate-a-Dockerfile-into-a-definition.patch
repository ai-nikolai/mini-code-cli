@@ -0,0 +1,144 @@
+"""Translate a task's Dockerfile into an Apptainer definition file.
+
+Apptainer 1.5 has no Dockerfile build: pointing `apptainer build` at a directory
+that holds a Dockerfile copies the *directory* into a 40 kB image and reports
+success, which is how a container ends up with no `bash` and no `/app`. The two
+supported routes are a prebuilt image or a definition file, so a task that only
+ships a Dockerfile needs one translated.
+
+Only what the task set actually uses is translated (single-stage `FROM`, `RUN`,
+`WORKDIR`, `ENV`, `COPY`/`ADD`, `CMD`). Anything else raises instead of being
+dropped: a silently ignored `ARG` or a skipped multi-stage build would produce a
+plausible image that fails inside the verifier, hours later.
+"""
+
+from __future__ import annotations
+
+import re
+import shlex
+from pathlib import Path
+
+#: Instructions that carry no meaning for a benchmark container.
+_IGNORED = {"CMD", "ENTRYPOINT", "EXPOSE", "LABEL", "HEALTHCHECK", "STOPSIGNAL",
+            "SHELL", "ONBUILD", "VOLUME", "MAINTAINER"}
+
+
+class UnsupportedDockerfile(ValueError):
+    """The Dockerfile uses something this translation cannot express safely."""
+
+
+def _logical_lines(text: str):
+    """Join continuations, drop comments and blank lines, keep order."""
+    buffer = ""
+    for raw in text.splitlines():
+        line = raw.strip()
+        if not buffer and (not line or line.startswith("#")):
+            continue
+        if line.endswith("\\"):
+            buffer += line[:-1].rstrip() + " "
+            continue
+        buffer += line
+        if buffer.strip():
+            yield buffer.strip()
+        buffer = ""
+    if buffer.strip():
+        yield buffer.strip()
+
+
+def to_definition(dockerfile: Path) -> str:
+    """Return an Apptainer definition equivalent to ``dockerfile``."""
+    instructions = list(_logical_lines(Path(dockerfile).read_text()))
+
+    base = None
+    post: list[str] = []
+    env: list[str] = []
+    files: list[str] = []
+    warnings: list[str] = []
+
+    for instruction in instructions:
+        keyword, _, rest = instruction.partition(" ")
+        keyword = keyword.upper()
+        rest = rest.strip()
+
+        if keyword == "FROM":
+            if base is not None:
+                raise UnsupportedDockerfile(
+                    "multi-stage builds are not supported; a single FROM is "
+                    "required (merge the stages, or supply a prebuilt image)")
+            if re.search(r"\bAS\b", rest, re.IGNORECASE):
+                raise UnsupportedDockerfile(
+                    f"FROM ... AS ({rest!r}) is a multi-stage build, which cannot "
+                    f"be translated; supply a prebuilt .sif or a .def")
+            if rest.startswith("--platform"):
+                raise UnsupportedDockerfile(
+                    "--platform in FROM is not supported by apptainer build")
+            base = rest
+        elif keyword in ("RUN", "WORKDIR", "COPY", "ADD", "ENV", "ARG", "USER"):
+            if base is None:
+                raise UnsupportedDockerfile(f"{keyword} before FROM")
+            if keyword == "RUN":
+                post.append(_strip_mounts(rest))
+            elif keyword == "WORKDIR":
+                # /app may not exist in the base image, and apptainer will refuse
+                # to start a container whose working directory is missing.
+                post.append(f"mkdir -p {shlex.quote(rest)}")
+            elif keyword == "ENV":
+                env.append(_env_line(rest))
+            elif keyword in ("COPY", "ADD"):
+                if "--from" in rest:
+                    raise UnsupportedDockerfile(
+                        f"{keyword} --from=... copies from another build stage")
+                if rest.startswith("--"):
+                    raise UnsupportedDockerfile(f"{keyword} flags ({rest!r})")
+                src, _, dst = rest.rpartition(" ")
+                files.append(f"{src.strip('[]\"')} {dst}")
+            elif keyword == "ARG":
+                # An ARG with a default is inlined by the caller; without one the
+                # image would differ from the Dockerfile's intent.
+                if "=" not in rest:
+                    raise UnsupportedDockerfile(
+                        f"ARG {rest!r} has no default; a Docker build would take it "
+                        f"from --build-arg, so the image cannot be reproduced")
+                env.append(_env_line(rest))
+            elif keyword == "USER":
+                warnings.append(f"USER {rest} ignored: the container runs as the "
+                                f"invoking user under --fakeroot")
+        elif keyword in _IGNORED:
+            continue
+        else:
+            raise UnsupportedDockerfile(f"unsupported instruction {keyword!r}")
+
+    if base is None:
+        raise UnsupportedDockerfile("no FROM line")
+
+    sections = [f"Bootstrap: docker\nFrom: {base}\n"]
+    if files:
+        sections.append("%files\n" + "\n".join(f"    {line}" for line in files))
+    if env:
+        sections.append("%environment\n" + "\n".join(f"    {line}" for line in env))
+    if post:
+        # The exports are repeated here because %post does not necessarily see
+        # %environment, and a RUN that references an ENV would otherwise expand
+        # to nothing (a silent, wrong image).
+        body = [*env, *post]
+        sections.append("%post\n" + "\n".join(f"    {line}" for line in body))
+    if warnings:
+        # Kept in the file so `apptainer build` echoes why the image differs.
+        sections.append("%help\n" + "\n".join(f"    # {line}" for line in warnings))
+    return "\n".join(sections) + "\n"
+
+
+def _strip_mounts(command: str) -> str:
+    """``RUN --mount=... cmd`` -> ``cmd`` (the mount is a cache, not content)."""
+    while command.startswith("--"):
+        _, _, command = command.partition(" ")
+        command = command.strip()
+    return command
+
+
+def _env_line(rest: str) -> str:
+    """``ENV A=1 B="x y"`` -> ``export A=1 B="x y"``; ``ENV A 1`` -> ``export A=1``."""
+    if "=" not in rest:
+        key, _, value = rest.partition(" ")
+        return f"export {key}={value.strip()}"
+    return f"export {rest}"
