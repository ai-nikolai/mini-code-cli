diff --git a/tests/unit/environments/test_singularity_dockerfile.py b/tests/unit/environments/test_singularity_dockerfile.py
new file mode 100644
index 00000000..62066278
--- /dev/null
+++ b/tests/unit/environments/test_singularity_dockerfile.py
@@ -0,0 +1,57 @@
+"""Translation of a task Dockerfile into an Apptainer definition file."""
+
+import pytest
+
+from harbor.environments.singularity.dockerfile import (
+    UnsupportedDockerfile,
+    to_definition,
+)
+
+
+def _definition(tmp_path, text):
+    path = tmp_path / "Dockerfile"
+    path.write_text(text)
+    return to_definition(path)
+
+
+def test_translation_keeps_the_base_image_and_commands(tmp_path):
+    definition = _definition(tmp_path, """# canary
+FROM ubuntu:24.04
+ENV BN_URL=https://example/x.csv
+WORKDIR /app
+RUN apt-get update && apt-get install -y r-base \\
+    && rm -rf /var/lib/apt/lists/*
+COPY data.csv /app/data.csv
+CMD ["bash"]
+""")
+    assert "Bootstrap: docker" in definition
+    assert "From: ubuntu:24.04" in definition
+    assert "export BN_URL=https://example/x.csv" in definition
+    # apptainer refuses to start with a missing working directory
+    assert "mkdir -p /app" in definition
+    # continuations are joined, comments dropped
+    assert "apt-get install -y r-base" in definition
+    assert "canary" not in definition
+    assert "data.csv /app/data.csv" in definition
+    # CMD is the harness's business, not the image's
+    assert "CMD" not in definition
+
+
+def test_translation_exports_env_inside_post(tmp_path):
+    definition = _definition(
+        tmp_path, "FROM alpine\nENV A=1\nRUN curl ${A} -o /x\n")
+    post = definition.split("%post", 1)[1]
+    assert "export A=1" in post, "a RUN must see the ENV it references"
+
+
+def test_translation_refuses_what_it_cannot_express(tmp_path):
+    cases = [
+        ("FROM a\nFROM b\n", "multi-stage"),
+        ("FROM a AS build\n", "multi-stage"),
+        ("FROM a\nARG UNPINNED\n", "no default"),
+        ("FROM a\nCOPY --from=build /x /y\n", "another build stage"),
+        ("FROM a\nFROBNICATE x\n", "unsupported instruction"),
+    ]
+    for text, expected in cases:
+        with pytest.raises(UnsupportedDockerfile, match=expected):
+            _definition(tmp_path, text)
