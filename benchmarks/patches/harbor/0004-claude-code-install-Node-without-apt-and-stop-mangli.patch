From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mini-code benchmarks <benchmarks@localhost>
Date: Fri, 23 Oct 2026 19:12:48 +0100
Subject: [PATCH] claude-code: install Node without apt, and stop mangling the
 model id

Two bugs that made `harbor run -a claude-code` fail on an Apptainer host before
the agent ever sent a request:

- `ensure_system_dependencies(("nodejs", "npm", ...))` runs apt-get, and inside a
  .sif (read-only squashfs + tmpfs overlay) dpkg cannot move an existing directory
  into the overlay: "unable to move aside './etc/logrotate.d' ... Invalid
  cross-device link". Node is now installed from the official static tarball into
  /opt with symlinks in /usr/local/bin -- it only *creates* files. The download
  falls back curl -> wget -> python3, because slim images often have no curl.
- the CLI itself was installed through `curl .../bootstrap.sh | bash`; with npm
  present (guaranteed by the tarball path) it now uses `npm install -g`, which
  works everywhere, and symlinks the binary onto PATH.

- `_resolved_model_name()` returned the `--model` string verbatim whenever a
  custom ANTHROPIC_BASE_URL was configured, so a self-hosted id was sent as
  `anthropic/ornith-ai/Ornith-1.5-35B-A3B` and the endpoint answered "There's an
  issue with the selected model ... may not exist or you may not have access".
  The leading segment is harbor's routing prefix, not part of the id: strip it
  when it equals the connection's provider.

Verified against vLLM 0.30 (`/v1/messages`, HTTP 200) on a terminal-bench task:
Claude Code installs, streams 49 assistant turns and only stops on its own time
budget, with no authentication error.
---
 src/harbor/agents/installed/claude_code.py | 93 +++++++++++++++++++---
 1 file changed, 82 insertions(+), 11 deletions(-)

diff --git a/src/harbor/agents/installed/claude_code.py b/src/harbor/agents/installed/claude_code.py
index c47eee47..673524db 100644
--- a/src/harbor/agents/installed/claude_code.py
+++ b/src/harbor/agents/installed/claude_code.py
@@ -29,6 +29,7 @@ from harbor.agents.protocols import ACPAgentMixin
 from harbor.environments.base import BaseEnvironment
 from harbor.models.agent.context import AgentContext
 from harbor.models.agent.name import AgentName
+from harbor.models.environment_type import EnvironmentType
 from harbor.models.bridge import BridgeKind
 from harbor.models.trajectories import (
     Agent,
@@ -470,26 +471,88 @@ class ClaudeCode(BaseInstalledAgent, ACPAgentMixin):
             )
             return
 
-        await self.ensure_system_dependencies(
-            environment, ("curl", "bash", "nodejs", "npm", "procps")
-        )
-        # Install claude-code (as default user)
+        if await self._needs_runtime_node(environment):
+            await self._install_node_from_tarball(environment)
+        else:
+            await self.ensure_system_dependencies(
+                environment, ("curl", "bash", "nodejs", "npm", "procps")
+            )
+        # Install claude-code (as default user). Prefer npm: the bootstrap
+        # script is fetched with curl, which slim images do not ship, and npm is
+        # guaranteed once _install_node_from_tarball has run.
         version_flag = f" {self._version}" if self._version else ""
+        spec = "@anthropic-ai/claude-code" + (f"@{self._version}" if self._version else "")
         await self.exec_as_agent(
             environment,
             command=(
                 "set -euo pipefail; "
-                "if command -v apk &> /dev/null; then"
-                f"  npm install -g @anthropic-ai/claude-code{'@' + self._version if self._version else ''};"
-                " else"
-                f"  curl -fsSL https://downloads.claude.ai/claude-code-releases/bootstrap.sh | bash -s --{version_flag};"
-                " fi && "
-                "echo 'export PATH=\"$HOME/.local/bin:$PATH\"' >> ~/.bashrc && "
-                'export PATH="$HOME/.local/bin:$PATH" && '
+                "if command -v npm >/dev/null 2>&1; then "
+                f"  npm install -g {spec}; "
+                "  npm_bin=\"$(npm prefix -g)/bin\"; "
+                "  if [ -d \"$npm_bin\" ]; then "
+                "    for exe in claude; do "
+                "      [ -e \"/usr/local/bin/$exe\" ] || "
+                "        ln -sf \"$npm_bin/$exe\" \"/usr/local/bin/$exe\" || true; "
+                "    done; "
+                "  fi; "
+                "else "
+                "  curl -fsSL https://downloads.claude.ai/claude-code-releases/bootstrap.sh"
+                f" | bash -s --{version_flag}; "
+                "  echo 'export PATH=\"$HOME/.local/bin:$PATH\"' >> ~/.bashrc; "
+                "  export PATH=\"$HOME/.local/bin:$PATH\"; "
+                "fi; "
                 "claude --version"
             ),
         )
 
+    async def _needs_runtime_node(self, environment: BaseEnvironment) -> bool:
+        """Whether Node must be installed without the system package manager.
+
+        Under Apptainer the container's root is a read-only .sif with a tmpfs
+        overlay, and dpkg cannot move an existing directory into that overlay:
+        `apt-get install nodejs` fails with "unable to move aside ... Invalid
+        cross-device link" and the agent never installs. A static Node tarball
+        extracted into /opt only *creates* files, which the overlay handles.
+        """
+        if environment.type() != EnvironmentType.SINGULARITY:
+            return False
+        probe = await environment.exec(
+            command="command -v node >/dev/null && command -v npm >/dev/null",
+            user="root",
+        )
+        return probe.return_code != 0
+
+    async def _install_node_from_tarball(self, environment: BaseEnvironment) -> None:
+        """Install Node into /opt (and /usr/local/bin) without dpkg."""
+        version = "22.14.0"  # current LTS; the CLI needs >= 18
+        # No curl in slim images, and apt is not an option (see above), so fall
+        # back to wget and then to python3, which these images always ship.
+        command = (
+            "set -euo pipefail; "
+            'arch="$(uname -m)"; '
+            'if [ "$arch" = "x86_64" ] || [ "$arch" = "amd64" ]; then'
+            " nodearch=linux-x64;"
+            ' elif [ "$arch" = "aarch64" ] || [ "$arch" = "arm64" ]; then'
+            " nodearch=linux-arm64;"
+            ' else echo "unsupported architecture: $arch" >&2; exit 1; fi; '
+            "mkdir -p /opt/node && cd /tmp && "
+            f'url="https://nodejs.org/dist/v{version}/node-v{version}-$'
+            '{nodearch}.tar.gz"; '
+            'if command -v curl >/dev/null 2>&1; then curl -fsSL "$url" -o node.tar.gz; '
+            'elif command -v wget >/dev/null 2>&1; then wget -qO node.tar.gz "$url"; '
+            'else python3 -c \'import sys, urllib.request; '
+            'urllib.request.urlretrieve(sys.argv[1], "node.tar.gz")\' "$url"; fi; '
+            "tar -xzf node.tar.gz -C /opt/node --strip-components=1 && "
+            "rm -f node.tar.gz && "
+            "ln -sf /opt/node/bin/node /usr/local/bin/node && "
+            "ln -sf /opt/node/bin/npm /usr/local/bin/npm && "
+            "ln -sf /opt/node/bin/npx /usr/local/bin/npx && "
+            "/opt/node/bin/node --version && /opt/node/bin/npm --version"
+        )
+        await self.exec_as_root(
+            environment, command=command, env={"DEBIAN_FRONTEND": "noninteractive"}
+        )
+
     @classmethod
     def _session_dirs(cls, agent_dir: Path) -> list[Path]:
         """Directories under an agent logs dir holding Claude session files.
@@ -1752,6 +1815,14 @@ class ClaudeCode(BaseInstalledAgent, ACPAgentMixin):
                     return self.model_name.split("/", 1)[-1]
                 return self.model_name
             if access.configured_base_url:
+                # The leading segment of --model is harbor's *routing* prefix
+                # ("anthropic/..."), not part of the id the endpoint serves: a
+                # self-hosted model id like ornith-ai/Ornith-1.5-35B-A3B is
+                # rejected by the server if it is sent as
+                # anthropic/ornith-ai/ornith-1.5-35b-a3b.
+                prefix = f"{access.provider}/" if access.provider else None
+                if prefix and self.model_name.startswith(prefix):
+                    return self.model_name[len(prefix):]
                 return self.model_name
             return self.model_name.split("/")[-1]
         return self._get_env("ANTHROPIC_MODEL") or None
-- 
